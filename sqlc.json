{
	"version": "2",
	"plugins": [
		{
			"name": "golang",
			"wasm": {
				"url": "https://github.com/vtuanjs/sqlc-gen-go/releases/download/v3.0.1/sqlc-gen-go.wasm",
				"sha256": "f6a02c8cb363c56bb7a7de1d1012a65e800897696de9d28b938563af02e3ce81"
			}
		}
	],
	"sql": [
		{
			"schema": "./migrations",
			"queries": "./queries",
			"engine": "postgresql",
			"codegen": [
				{
					"plugin": "golang",
					"out": "./sqlc",
					"options": {
						"package": "sqlc",
						"sql_package": "pgx/v5",
						"sql_driver": "github.com/jackc/pgx/v5",

						"emit_dynamic_filter": true,
						"emit_db_tags": true,

						"emit_prepared_queries": false,
						"json_tags_case_style": "snake",
						"emit_empty_slices": true,
						"emit_json_tags": true,

						"overrides": [
						{
							"db_type": "pg_catalog.int4",
							"go_type": "int"
						},
						{
							"db_type": "pg_catalog.int4",
							"nullable": true,
							"go_type": {
								"type": "int",
								"pointer": true
							}
						},
							{
								"db_type": "pg_catalog.int8",
								"go_type": "int"
							},
							{
								"db_type": "pg_catalog.int8",
								"nullable": true,
								"go_type": {
									"type": "int",
									"pointer": true
								}
							},
							{
								"db_type": "bigserial",
								"go_type": "int"
							},
							{
								"db_type": "integer",
								"go_type": "int"
							},
							{
								"db_type": "integer",
								"nullable": true,
								"go_type": {
									"type": "int",
									"pointer": true
								}
							},
							{
								"db_type": "pg_catalog.int2",
								"go_type": "int16"
							},
							{
								"db_type": "pg_catalog.int2",
								"nullable": true,
								"go_type": {
									"type": "int16",
									"pointer": true
								}
							},
							{
								"db_type": "pg_catalog.numeric",
								"go_type": "github.com/shopspring/decimal.Decimal"
							},
							{
								"db_type": "pg_catalog.numeric",
								"nullable": true,
								"go_type": {
									"type": "float64",
									"pointer": true
								}
							},
							{
								"db_type": "double precision",
								"go_type": "float64"
							},
							{
								"db_type": "double precision",
								"nullable": true,
								"go_type": {
									"type": "float64",
									"pointer": true
								}
							},
							{
								"db_type": "real",
								"go_type": "float32"
							},
							{
								"db_type": "real",
								"nullable": true,
								"go_type": {
									"type": "float32",
									"pointer": true
								}
							},
							{
								"db_type": "boolean",
								"go_type": "bool"
							},
							{
								"db_type": "boolean",
								"nullable": true,
								"go_type": {
									"type": "bool",
									"pointer": true
								}
							},
							{
								"db_type": "bool",
								"go_type": "bool"
							},
							{
								"db_type": "bool",
								"nullable": true,
								"go_type": {
									"type": "bool",
									"pointer": true
								}
							},
							{
								"db_type": "pg_catalog.varchar",
								"nullable": true,
								"go_type": {
									"type": "string",
									"pointer": true
								}
							},
							{
								"db_type": "text",
								"nullable": true,
								"go_type": {
									"type": "string",
									"pointer": true
								}
							},
							{
								"db_type": "pg_catalog.bpchar",
								"nullable": true,
								"go_type": {
									"type": "string",
									"pointer": true
								}
							},
							{
								"db_type": "jsonb",
								"go_type": {
									"import": "encoding/json",
									"type": "RawMessage"
								}
							},
							{
								"db_type": "jsonb",
								"nullable": true,
								"go_type": {
									"import": "encoding/json",
									"type": "RawMessage"
								}
							},
							{
								"db_type": "json",
								"go_type": {
									"import": "encoding/json",
									"type": "RawMessage"
								}
							},
							{
								"db_type": "json",
								"nullable": true,
								"go_type": {
									"import": "encoding/json",
									"type": "RawMessage"
								}
							},
							{
								"db_type": "pg_catalog.timestamptz",
								"go_type": "time.Time"
							},
							{
								"db_type": "pg_catalog.timestamptz",
								"nullable": true,
								"go_type": {
									"type": "time.Time",
									"pointer": true
								}
							},
							{
								"db_type": "pg_catalog.timestamp",
								"go_type": "time.Time"
							},
							{
								"db_type": "timestamptz",
								"go_type": "time.Time"
							},
							{
								"db_type": "pg_catalog.timestamp",
								"nullable": true,
								"go_type": {
									"type": "time.Time",
									"pointer": true
								}
							},
							{
								"db_type": "date",
								"go_type": "time.Time"
							},
							{
								"db_type": "date",
								"nullable": true,
								"go_type": {
									"type": "time.Time",
									"pointer": true
								}
							},
							{
								"db_type": "pg_catalog.interval",
								"go_type": "time.Duration"
							},
							{
								"db_type": "pg_catalog.interval",
								"nullable": true,
								"go_type": {
									"type": "time.Duration",
									"pointer": true
								}
							},
							{
								"db_type": "uuid",
								"go_type": "string"
							},
							{
								"db_type": "uuid",
								"nullable": true,
								"go_type": {
									"type": "string",
									"pointer": true
								}
							}
						]
					}
				}
			]
		}
	]
}
